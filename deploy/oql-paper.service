# Paper trading: fetch newly closed bars and journal decisions for every deployment in ~/lab/paper/. No orders are sent.
# Install only once a card is deployed (oql paper deploy ...):
#   sudo cp oql-paper.service oql-paper.timer /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now oql-paper.timer
[Unit]
Description=Open Quant Lab paper trading step
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=david
WorkingDirectory=/home/david/lab
Environment=OQL_LAB=/home/david/lab
ExecStart=/home/david/open-quant-lab/.venv/bin/oql paper step
